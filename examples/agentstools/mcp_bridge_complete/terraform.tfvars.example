# Copy this file to terraform.tfvars and fill in your values
# cp terraform.tfvars.example terraform.tfvars

# Connected App credentials
anypoint_client_id     = "your-connected-app-client-id"
anypoint_client_secret = "your-connected-app-client-secret"
anypoint_base_url      = "https://anypoint.mulesoft.com"

# Where the bridges are created
organization_id = "your-org-id"
environment_id  = "your-environment-id"

# The self-managed Flex Gateway you already run
self_managed_gateway_id = "your-self-managed-gateway-id"
gateway_public_url      = "https://flex.example.com"

# Bridge 1 — tools declared explicitly, on port 8081
explicit_bridge_name = "orders-mcp-bridge"
explicit_bridge_port = 8081
orders_asset_id      = "orders-api"
orders_asset_version = "1.0.0"
orders_upstream_uri  = "https://orders.internal.example.com"

# TLS for the orders upstream, as "<secretGroupId>/<tlsContextId>".
# Leave empty for a plain http backend.
orders_tls_context_id = ""

# Bridge 2 — tools parsed from the spec, on a different port
autoparse_bridge_name   = "inventory-mcp-bridge"
autoparse_bridge_port   = 8082
inventory_asset_id      = "inventory-api"
inventory_asset_version = "1.0.0"
inventory_upstream_uri  = "https://inventory.internal.example.com"

# Optional external client provider; empty uses Anypoint's built-in provider
client_provider_id = ""
